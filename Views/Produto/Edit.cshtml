@model Produto
@{ ViewData["Title"] = "Editar Produto"; }
<h2>Editar Produto</h2>
<div class="col-md-5">
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ProdutoId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Preco" class="form-label"></label><input asp-for="Preco" class="form-control" type="number" step="0.01" /></div>
    <div class="mb-3"><label asp-for="Estoque" class="form-label"></label><input asp-for="Estoque" class="form-control" type="number" /></div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
</div>
