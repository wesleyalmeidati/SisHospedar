@model Hospedagem
@{ ViewData["Title"] = "Finalizar Hospedagem"; }
<h2>Finalizar Hospedagem</h2>
<dl class="row">
    <dt class="col-sm-3">Hóspede</dt><dd class="col-sm-9">@Model.Hospede?.Nome</dd>
    <dt class="col-sm-3">Apartamento</dt><dd class="col-sm-9">@Model.Apartamento?.Numero</dd>
    <dt class="col-sm-3">Total de Consumo</dt><dd class="col-sm-9">@Model.TotalConsumo.ToString("C")</dd>
</dl>
<div class="alert alert-info">Ao confirmar, a data de saída será registrada como hoje e o apartamento voltará a ficar disponível.</div>
<form asp-action="Finalizar" method="post">
    <input type="hidden" asp-for="HospedagemId" />
    <button type="submit" class="btn btn-warning">Confirmar Finalização</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
