@model Apartamento
@{ ViewData["Title"] = "Detalhes do Apartamento"; }
<h2>Detalhes do Apartamento</h2>
<dl class="row">
    <dt class="col-sm-3">Número</dt><dd class="col-sm-9">@Model.Numero</dd>
    <dt class="col-sm-3">Capacidade</dt><dd class="col-sm-9">@Model.Capacidade</dd>
    <dt class="col-sm-3">Diária</dt><dd class="col-sm-9">@Model.ValorDiaria.ToString("C")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
