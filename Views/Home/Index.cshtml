@model IEnumerable<(int Capacidade, decimal ValorDiaria)>
@{
    ViewData["Title"] = "SisHospedar";

    // PT: O modelo de Apartamento não guarda foto — usamos um conjunto fixo de
    //     imagens de banco livre (Pexels), indexadas pela Capacidade, só para dar a
    //     moldura visual do card de cada tipo. Cada foto foi escolhida por bater com
    //     a configuração de cama do tipo (uma cama de solteiro / uma de casal / uma
    //     de casal + uma de solteiro) — não são fotos reais dos quartos do hotel.
    //     O NOME do tipo, por outro lado, saiu daqui: antes havia um dicionário
    //     local repetindo "Suíte Standard/Executivo/Master", que era uma segunda
    //     cópia da mesma regra que o dropdown de reserva precisava. Agora vem de
    //     Apartamento.CategoriaPara, fonte única — renomear uma categoria passa a
    //     valer na home e nos formulários ao mesmo tempo.
    // EN: Apartamento has no photo field — we use a fixed set of stock images
    //     (Pexels), keyed by Capacidade, purely to give each type card its visual
    //     frame. Each photo was picked to match that type's actual bed setup (one
    //     single bed / one double bed / one double + one single) — these aren't real
    //     photos of the hotel's rooms.
    //     The type NAME, on the other hand, moved out of here: there used to be a
    //     local dictionary repeating "Suíte Standard/Executivo/Master", a second copy
    //     of the same rule the booking dropdown needed. It now comes from
    //     Apartamento.CategoriaPara, a single source — renaming a category now takes
    //     effect on the home page and in the forms at once.
    var fotoPorTipo = new Dictionary<int, string>
    {
        [1] = "https://images.pexels.com/photos/9899843/pexels-photo-9899843.jpeg?auto=compress&cs=tinysrgb&w=800",
        [2] = "https://images.pexels.com/photos/30708768/pexels-photo-30708768.jpeg?auto=compress&cs=tinysrgb&w=800",
        [3] = "https://images.pexels.com/photos/16153351/pexels-photo-16153351.jpeg?auto=compress&cs=tinysrgb&w=800",
    };

    // PT: Comodidades reais do hotel, cada uma com uma foto de banco livre (Pexels)
    //     escolhida pra bater com a comodidade de verdade — o estacionamento é um
    //     quintal gramado, com canteiros separando as vagas (não um pátio de
    //     asfalto genérico), então a foto buscada mostra um carro sobre piso
    //     drenante/grama em vez de asfalto.
    // EN: The hotel's real amenities, each with a stock photo (Pexels) chosen to
    //     match the actual amenity — parking is a grassy yard, with garden beds
    //     dividing the spots (not a generic paved lot), so the photo picked shows
    //     a car on permeable/grass paving instead of asphalt.
    var comodidades = new[]
    {
        ("https://images.pexels.com/photos/19033530/pexels-photo-19033530.jpeg?auto=compress&cs=tinysrgb&w=800", "Café da manhã regional incluso"),
        ("https://images.pexels.com/photos/17004869/pexels-photo-17004869.jpeg?auto=compress&cs=tinysrgb&w=800", "Estacionamento privativo"),
        ("https://images.pexels.com/photos/5481232/pexels-photo-5481232.jpeg?auto=compress&cs=tinysrgb&w=800", "Wi-Fi em todo o hotel"),
    };
}

<div class="hero-hotel">
    @* PT: Toca automaticamente se você colocar wwwroot/videos/hero.mp4 (veja o
           README.md naquela pasta). Sem o arquivo, cai na foto de cachoeira de
           fundo (definida em site.css) sem quebrar nada.
       EN: Plays automatically once you add wwwroot/videos/hero.mp4 (see the
           README.md in that folder). Without the file, it falls back to the
           waterfall background photo (set in site.css) without breaking anything. *@
    @if ((bool?)ViewData["TemVideoHero"] == true)
    {
        <video class="hero-video" autoplay muted loop playsinline>
            <source src="~/videos/hero.mp4" type="video/mp4" />
        </video>
    }
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1 class="hero-title">Conforto e hospitalidade em cada detalhe.</h1>
        <p class="hero-lead">Reserve sua estadia em poucos minutos e viva uma experiência pensada para o seu descanso.</p>
        <div class="hero-actions">
            @* PT: Leva direto ao formulário de reserva, que é público. O visitante escolhe
                   apartamento e datas antes de qualquer pedido de conta; a autenticação só
                   aparece ao efetivar, levando a escolha junto (ver ReservaController.Create).
                   Antes daqui saía para /Cliente/Login, e a pessoa via uma tela de senha sem
                   nunca ter visto o que estava reservando.
               EN: Goes straight to the booking form, which is public. The visitor picks room
                   and dates before any account is asked for; authentication only shows up at
                   the point of committing, carrying the choice along (see
                   ReservaController.Create). This used to lead to /Cliente/Login, where the
                   person met a password screen without ever seeing what they were booking. *@
            <a class="btn btn-brass btn-lg" asp-controller="Reserva" asp-action="Create">Reservar Agora</a>
        </div>
    </div>
</div>

<section class="mt-5 pt-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <p class="section-eyebrow">Acomodações</p>
            <h2>Tipos de acomodação</h2>
        </div>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">No momento não há acomodações cadastradas.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var tipo in Model)
            {
                @* PT: A acomodação (Solteiro/Casal/Triplo) entra junto da categoria porque
                       o preço sozinho não diz para quantas pessoas o quarto serve — era
                       preciso abrir a reserva para descobrir.
                   EN: The occupancy (Solteiro/Casal/Triplo) appears alongside the category
                       because the price alone doesn't say how many people the room sleeps —
                       you had to open the booking form to find out. *@
                var nome = $"Suíte {Apartamento.CategoriaPara(tipo.Capacidade)}";
                var acomodacao = Apartamento.AcomodacaoPara(tipo.Capacidade);
                var foto = fotoPorTipo.TryGetValue(tipo.Capacidade, out var url) ? url : fotoPorTipo[1];

                <div class="col-md-4">
                    <div class="room-card">
                        <div class="room-card-header" style="background-image:url('@foto')">
                            <span class="room-number">@nome</span>
                        </div>
                        <div class="room-card-body">
                            <p class="text-muted mb-1" style="font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;">@acomodacao</p>
                            <p class="room-price">@tipo.ValorDiaria.ToString("C") <span>/ noite</span></p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

<section class="amenities mt-5">
    <div class="container">
        <p class="section-eyebrow">Comodidades</p>
        <h2 class="mb-4">Tudo pensado para você</h2>
        <div class="row g-4">
            @foreach (var (foto, titulo) in comodidades)
            {
                <div class="col-md-4">
                    <div class="amenity-item">
                        <div class="amenity-photo" style="background-image:url('@foto')"></div>
                        <p class="amenity-title">@titulo</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
