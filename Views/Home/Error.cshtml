@{
    ViewData["Title"] = "Erro";
}
<div class="auth-shell">
    <div class="auth-card">
        <p class="auth-eyebrow">SisHospedar</p>
        <h2 class="auth-title">Algo deu errado</h2>
        <p class="text-center text-muted">
            Não conseguimos concluir sua última ação. Tente novamente em alguns instantes —
            se o problema continuar, avise a recepção.
        </p>
        <p class="text-center mt-4 mb-0" style="font-size:.88rem;">
            <a asp-controller="Home" asp-action="Index">Voltar para a página inicial</a>
        </p>
    </div>
</div>
