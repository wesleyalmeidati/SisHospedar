@model Funcionario
@{ ViewData["Title"] = "Novo Funcionário"; }
<h2>Novo Funcionário</h2>
<div class="col-md-5">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Cargo" class="form-label"></label>
        <select asp-for="Cargo" class="form-select" asp-items="Html.GetEnumSelectList<CargoFuncionario>()"></select>
    </div>
    <div class="mb-3"><label class="form-label">Senha</label><input name="senha" type="password" class="form-control" /></div>
    <div class="form-text mb-3">O login é gerado automaticamente a partir do nome (ex.: "Luan Santos" → <code>luan.santos</code>).</div>
    <div class="mb-3">
        <label asp-for="HospedeId" class="form-label"></label>
        <select asp-for="HospedeId" class="form-select" asp-items="ViewBag.HospedeId">
            <option value="">-- Nenhum (não é hóspede) --</option>
        </select>
        <div class="form-text">Preencha apenas se este funcionário também possuir cadastro de hóspede.</div>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
</div>
