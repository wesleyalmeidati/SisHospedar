@model Funcionario
@{ ViewData["Title"] = "Excluir Funcionário"; }
<h2>Excluir Funcionário</h2>
<div class="alert alert-warning">Tem certeza que deseja excluir este funcionário?</div>
<dl class="row"><dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@Model.Nome</dd></dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="FuncionarioId" />
    <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
