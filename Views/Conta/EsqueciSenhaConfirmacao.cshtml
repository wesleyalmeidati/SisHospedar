@{
    ViewData["Title"] = "Redefinição de senha";
}
<div class="auth-shell">
    <div class="auth-card">
        <p class="auth-eyebrow">SisHospedar</p>
        <h2 class="auth-title">Verifique seu e-mail</h2>
        <p class="text-center text-muted">
            Se existir uma conta com esse login e um e-mail cadastrado, enviamos um link de redefinição para ele.
            Sem e-mail cadastrado (comum para contas de funcionário criadas pela recepção), peça a um Administrador
            ou Gerente para redefinir sua senha.
        </p>
        <p class="text-center mt-4 mb-0" style="font-size:.88rem;">
            <a asp-controller="Home" asp-action="Login">Voltar ao login</a>
        </p>
    </div>
</div>
