@{ ViewData["Title"] = "Esqueci minha senha"; }
<div class="auth-shell">
    <div class="auth-card">
        <p class="auth-eyebrow">SisHospedar</p>
        <h2 class="auth-title">Esqueci minha senha</h2>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <form asp-action="EsqueciSenha" method="post">
            <div class="mb-3">
                <label class="form-label">E-mail</label>
                <input name="email" type="email" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Enviar</button>
            <p class="text-center mt-4 mb-0" style="font-size:.88rem;">
                <a asp-controller="Home" asp-action="Login">Voltar ao login</a>
            </p>
        </form>
    </div>
</div>
