<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotel Solaris</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Hotel Solaris</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                @{
                    // PT: Nenhum dos dois esquemas é "padrão", então checamos os dois
                    //     cookies explicitamente — é assim que a navbar sabe qual dos
                    //     dois (ou nenhum) está logado em qualquer página, mesmo as
                    //     públicas sem [Authorize].
                    // EN: Neither scheme is "default", so we check both cookies
                    //     explicitly — this is how the navbar knows which of the two
                    //     (or neither) is logged in on any page, even public ones
                    //     with no [Authorize].
                    var funcionarioAuth = await Context.AuthenticateAsync(Esquemas.Funcionario);
                    var hospedeAuth = await Context.AuthenticateAsync(Esquemas.Hospede);
                    var funcionarioNome = funcionarioAuth.Succeeded
                        ? funcionarioAuth.Principal!.FindFirstValue(ClaimTypes.Name) : null;
                    var hospedeNome = hospedeAuth.Succeeded
                        ? hospedeAuth.Principal!.FindFirstValue(ClaimTypes.Name) : null;
                }

                @if (funcionarioNome != null)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Painel" asp-action="Index">Painel</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Hospedagem" asp-action="Index">Hospedagens</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Hospede" asp-action="Index">Hóspedes</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Apartamento" asp-action="Index">Apartamentos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Produto" asp-action="Index">Produtos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Funcionario" asp-action="Index">Funcionários</a></li>
                    </ul>
                    <span class="navbar-text text-white me-3">@funcionarioNome</span>
                    <a class="btn btn-outline-light btn-sm" asp-controller="Home" asp-action="Logout">Sair</a>
                }
                else if (hospedeNome != null)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Início</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cliente" asp-action="MinhaConta">Minha Conta</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reserva" asp-action="Create">Nova Reserva</a></li>
                    </ul>
                    <span class="navbar-text text-white me-3">@hospedeNome</span>
                    <a class="btn btn-outline-light btn-sm" asp-controller="Cliente" asp-action="Logout">Sair</a>
                }
                else
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Início</a></li>
                    </ul>
                    <a class="btn btn-outline-light btn-sm me-2" asp-controller="Cliente" asp-action="Login">Sou Hóspede</a>
                    <a class="btn btn-outline-light btn-sm" asp-controller="Home" asp-action="Login">Sou Funcionário</a>
                }
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Sucesso"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3">
        Hotel Solaris &copy; @DateTime.Now.Year — Sistema desenvolvido por Wesley Sales de Almeida
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
